PORT=3100
FRONTEND_ORIGIN=http://localhost:5180

# Alamat Gmail pengirim
GMAIL_USER=emailanda@gmail.com
# App Password 16 karakter (bukan password login biasa)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# --- Opsional: login & akses ---
# Email yang otomatis menjadi admin saat mendaftar. Kosong = pendaftar pertama menjadi admin.
ADMIN_EMAIL=
# Client ID OAuth Google untuk tombol "Masuk dengan Google" (bisa juga diisi lewat halaman Pengaturan)
GOOGLE_CLIENT_ID=
# URL publik aplikasi untuk tautan reset password, mis. https://notify.contoh.com
APP_URL=
# Isi 1 jika di belakang reverse proxy (Nginx) agar cookie Secure & IP pengguna terbaca benar
TRUST_PROXY=

# --- Mode demo ---
# 1 = tampilkan & sediakan akun contoh (admin/admin123 dan demo/demo123) di halaman login.
# 0 = nonaktif dan akun demo DIHAPUS dari database saat server start.
# Kosong = otomatis: aktif saat pengembangan, nonaktif jika NODE_ENV=production
# (./app.sh start selalu memakai NODE_ENV=production).
DEMO_MODE=
